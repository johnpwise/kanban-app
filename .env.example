# Firebase client SDK config (public by design — see src/lib/firebase/client.ts).
# Get these from the Firebase console: Project settings -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to host:port (e.g. 127.0.0.1:9099) to point the browser-side Auth SDK at the
# Firebase Auth emulator instead of production. Used automatically by `npm run test:e2e`.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Server-only Firebase Admin credential. Cloudflare requires this as an encrypted Worker
# secret because Workers cannot read a GOOGLE_APPLICATION_CREDENTIALS filesystem path.
# Paste the complete service-account JSON object as the value; never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=
