{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanban-app",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": true,
  "secrets": {
    "required": [
      "FIREBASE_SERVICE_ACCOUNT_JSON"
    ]
  },
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
