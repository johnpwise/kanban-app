# ADA executor Cloud Run Job deployment config.
#
# Copy this file to `config.env` (gitignored) and adjust values, or export the same names as real
# environment variables before running `deploy.sh` — either way works, `deploy.sh` sources
# `config.env` only if it exists and never overrides variables already set in the environment.
#
# None of these values are secrets: they are GCP resource identifiers, not credentials. Auth is
# always via the operator's own `gcloud auth login` session (deploy-time) or the runtime service
# account's Application Default Credentials (Job execution time) — never a stored key.

# GCP project that hosts Firestore, Artifact Registry, and Cloud Run for this app.
ADA_GCP_PROJECT_ID=kanban-app-fa4b7

# Region for the Artifact Registry repo and the Cloud Run Job. Matches the existing Firestore
# location (europe-west2) confirmed for this project — change only if inspection later proves this
# invalid.
ADA_GCP_REGION=europe-west2

# Artifact Registry Docker repository name (created once by `deploy.sh setup`).
ADA_ARTIFACT_REPO=ada-executor

# Image name within that repository.
ADA_IMAGE_NAME=executor

# Cloud Run Job name.
ADA_JOB_NAME=ada-executor

# Dedicated runtime service account for the Job (created once by `deploy.sh setup`). Granted only
# roles/datastore.viewer (read-only Firestore access) — see deploy/README.md.
ADA_RUNTIME_SERVICE_ACCOUNT=ada-executor-runtime@kanban-app-fa4b7.iam.gserviceaccount.com

# Optional: image tag. Defaults to the current short git commit SHA when unset (immutable,
# preferred over floating on `latest`).
# ADA_IMAGE_TAG=
