{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-lens-manifest.schema.json",
  "title": "Conservative review-lens manifest",
  "type": "object",
  "required": ["schemaVersion", "stack", "sliceSpec", "diff", "lenses", "loadReferences", "hash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stack": { "enum": ["react", "vue", "nextjs", "node-express", "node-express-ts"] },
    "sliceSpec": {
      "type": "object",
      "required": ["sliceId", "workflowId", "revision", "hash"],
      "properties": {
        "sliceId": { "$ref": "#/$defs/nonEmptyString" },
        "workflowId": { "type": ["string", "null"] },
        "revision": { "type": "integer", "minimum": 1 },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["files", "hash"],
      "properties": {
        "files": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reference", "disposition", "reasonCodes", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "reference": { "pattern": "^references/[a-z0-9-]+\\.md$" },
          "disposition": { "enum": ["include", "skip"] },
          "reasonCodes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "uniqueItems": true
          },
          "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "loadReferences": {
      "type": "array",
      "items": { "pattern": "^references/[a-z0-9-]+\\.md$" },
      "uniqueItems": true
    },
    "hash": { "$ref": "#/$defs/sha256" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
