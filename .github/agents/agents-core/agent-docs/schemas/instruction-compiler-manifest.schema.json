{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-core/instruction-compiler-manifest.schema.json",
  "title": "Phase-specific instruction compiler manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compilerId",
    "supported",
    "layers",
    "fragments",
    "requirements"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "compilerId": { "type": "string", "minLength": 1 },
    "supported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stacks", "requestTypes", "phases", "triggers"],
      "properties": {
        "stacks": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "requestTypes": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "phases": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "triggers": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "precedence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "precedence": { "type": "integer" }
        }
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "policyId", "layer", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "policyId": { "type": "string", "minLength": 1 },
          "layer": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "protected": { "type": "boolean" },
          "overrides": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
          "when": { "$ref": "#/$defs/selector" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "policyIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "policyIds": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
          "when": { "$ref": "#/$defs/selector" }
        }
      }
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stacks": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "requestTypes": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "phases": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "triggersAll": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "triggersAny": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    }
  }
}
